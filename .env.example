# daup-duidelik — environment (P3/SSO wiring; unused until the SSO phase)
#
# The seed origin the app talks to for the house session + data. On-prem only
# changes THIS value; the Cloudflare bundle is identical (DAUP-PORT-PLAN §O3). The
# plan requires this be RUNTIME-configurable (read from the /d/hub handoff hint,
# falling back to the baked default below) — so this VITE_ constant is only the
# fallback, not the single source.
VITE_HOUSE_SEED_URL=https://mcp.daup.co.za

# Production-strict mode: when true, the app REQUIRES a redeemed house session and
# will not fall back to the standalone local "acting as" identity (DAUP-PORT-PLAN §4).
# Left false for local/demo so the app runs without the Hub.
VITE_REQUIRE_HOUSE_SESSION=false
