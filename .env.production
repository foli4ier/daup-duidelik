# daup-duidelik — PRODUCTION build env.
# Vite loads this file ONLY for `vite build` (the Workers Builds deploy), never for
# `vite dev` — so local/demo keeps the standalone "acting as" fallback while the live
# site at duidelik.daup.co.za is house-session-gated.

# Production-strict: REQUIRE a redeemed house session. A direct hit with no /d/hub
# handoff shows "open from the Hub" instead of the standalone picker (DAUP-PORT-PLAN §4).
VITE_REQUIRE_HOUSE_SESSION=true

# Seed-origin fallback. Optional — the baked default (https://mcp.daup.co.za) lives in
# code and the real origin is resolved at runtime from the /d/hub hint (O3). Set here
# only to override the fallback for the production build.
# VITE_HOUSE_SEED_URL=https://mcp.daup.co.za
